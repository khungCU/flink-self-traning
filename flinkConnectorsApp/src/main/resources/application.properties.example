# MySQL CDC Source Configuration
# Copy this file to application.properties and fill in your values
# DO NOT commit application.properties to version control

mysql.hostname=localhost
mysql.port=3306
mysql.database=your_database
mysql.table=your_database.your_table
mysql.username=your_username
mysql.password=your_password

postgres.hostname=localhost
postgres.port=5432
postgres.database=pgdb
postgres.username=your_username
postfres.password=your_password